{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "feynman": {
      "type": "string",
      "minLength": 1
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["basic", "cloze", "reversed"]
          },
          "front": {
            "type": "string",
            "minLength": 1
          },
          "back": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["type", "front", "back", "tags"]
      }
    }
  },
  "required": ["feynman", "cards"]
}
