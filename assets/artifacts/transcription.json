{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["cover", "blank", "content", "unknown"]
    },
    "markdown": {
      "type": "string"
    },
    "needs_review": {
      "type": "boolean"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": ["label", "text", "bbox"]
      }
    }
  },
  "required": ["kind", "markdown", "needs_review", "uncertainties"]
}
