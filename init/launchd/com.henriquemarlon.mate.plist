<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.henriquemarlon.mate</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/henriquemarlon/.local/share/mise/shims/mate</string>
		<string>run</string>
		<string>--study-dir=/Users/henriquemarlon/GoodNotes</string>
		<string>--output-dir=/Users/henriquemarlon/.mate/output</string>
		<string>--state-db=/Users/henriquemarlon/.mate/state.db</string>
		<string>--anki-endpoint=http://127.0.0.1:8765</string>
		<string>--log-color=false</string>
	</array>

	<!-- launchd starts agents with a minimal PATH and no shell profile.
	     The OpenAI-compatible client requires a non-empty API key. Read a
	     placeholder from a file because the local proxy ignores the value. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/henriquemarlon/.local/share/mise/shims:/Users/henriquemarlon/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>MATE_LLM_API_KEY_FILE</key>
		<string>/Users/henriquemarlon/.mate/llm_api_key</string>
		<key>MATE_LLM_BASE_URL</key>
		<string>http://127.0.0.1:18080/v1</string>
		<key>MATE_LLM_MODEL</key>
		<string>gpt-5.6-luna</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>/Users/henriquemarlon/.mate/launchd.stdout.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/henriquemarlon/.mate/launchd.stderr.log</string>
</dict>
</plist>
