<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.henriquemarlon.mate</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/docker</string>
		<string>run</string>
		<string>--rm</string>
		<string>--init</string>
		<string>--pull=missing</string>
		<string>-v</string>
		<string>/Users/henriquemarlon/GoodNotes:/notes:ro</string>
		<string>-v</string>
		<string>/Users/henriquemarlon/.mate:/home/mate/.mate</string>
		<string>-v</string>
		<string>/Users/henriquemarlon/.codex:/home/mate/.codex</string>
		<string>ghcr.io/henriquemarlon/mate:latest</string>
		<string>run</string>
		<string>--study-dir=/notes</string>
		<string>--output-dir=/home/mate/.mate/output</string>
		<string>--state-db=/home/mate/.mate/state.db</string>
		<string>--log-color=false</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>StartInterval</key>
	<integer>900</integer>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>/Users/henriquemarlon/.mate/launchd.stdout.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/henriquemarlon/.mate/launchd.stderr.log</string>
</dict>
</plist>
