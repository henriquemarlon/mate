<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.henriquemarlon.codex-proxy</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>mkdir -p "$HOME/.mate" &amp;&amp;
exec "$HOME/.local/bin/mise" exec github:hotchpotch/openai-api-server-via-codex -- openai-api-server-via-codex \
  --host 127.0.0.1 \
  --port 18080 \
  --auth-json "$HOME/.codex/auth.json" \
  --default-model gpt-5.6-luna \
  &gt;&gt;"$HOME/.mate/codex-proxy.stdout.log" \
  2&gt;&gt;"$HOME/.mate/codex-proxy.stderr.log"</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>ProcessType</key>
	<string>Background</string>

</dict>
</plist>
