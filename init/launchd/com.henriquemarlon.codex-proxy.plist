<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.henriquemarlon.codex-proxy</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/henriquemarlon/.local/share/mise/shims/openai-api-server-via-codex</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>18080</string>
		<string>--auth-json</string>
		<string>/Users/henriquemarlon/.codex/auth.json</string>
		<string>--default-model</string>
		<string>gpt-5.6-luna</string>
